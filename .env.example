APP_NAME=哈基米sama
APP_ENV=development
LOG_LEVEL=INFO

# Pydantic AI model identifier. Examples:
# openai:gpt-4.1-mini, deepseek:deepseek-v4-flash, google-gla:gemini-2.5-flash
AI_MODEL=openai:gpt-4.1-mini
AGENT_INSTRUCTIONS="You are 哈基米sama, a reliable product assistant represented by a friendly orange cat. Be concise, accurate, and use tools when useful."

# Set the key required by your selected provider.
OPENAI_API_KEY=
# DeepSeek V4 native web search uses this same key through the Anthropic-compatible API.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Native web search is currently enabled for deepseek-v4-* models.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=3
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
WORKSPACE_WRITE_ENABLED=true

# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
AUTO_CREATE_TABLES=true
SQL_ECHO=false

# Local Markdown knowledge base. Files are re-read on each search in the MVP.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_MAX_RESULTS=8

# Empty disables service-level API-key authentication for local development.
SERVICE_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
