APP_NAME=哈基米sama
APP_ENV=development
LOG_LEVEL=INFO

# Pydantic AI model identifier. Examples:
# openai:gpt-6.1-sol, deepseek:deepseek-v4-flash, google-gla:gemini-2.5-flash
# GPT-6.1 Sol uses the OpenAI Responses API for tool calling.
AI_MODEL=openai:gpt-6.1-sol
DEFAULT_AGENT_PROFILE=code
AGENT_PROFILE_DIR=agent_profiles
AGENT_INSTRUCTIONS="You are 哈基米sama, a reliable product assistant represented by a friendly orange cat. Be concise, accurate, and use tools when useful."

# Create your own OpenAI developer-platform key at https://platform.openai.com/api-keys
# Fill it in locally; never commit a real key.
OPENAI_API_KEY=
# DeepSeek V4 native web search uses this same key through the Anthropic-compatible API.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Native web search is currently enabled for deepseek-v4-* models.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_USES=3
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
WORKSPACE_WRITE_ENABLED=true

# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
AUTO_CREATE_TABLES=true
SQL_ECHO=false

# Local Markdown knowledge base with a persistent incremental FTS5 index.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_MAX_RESULTS=8
# Use memory only for ephemeral tests or very small temporary collections.
KNOWLEDGE_INDEX_BACKEND=sqlite_fts5
KNOWLEDGE_INDEX_PATH=data/knowledge-index.db

# Published procedural Skills. The model sees only name + description until load_skill.
SKILLS_ENABLED=true
SKILLS_DIR=skills
SKILL_MAX_BYTES=64000
SKILL_CATALOG_DESCRIPTION_MAX_LENGTH=500

# Built-in customer-support example Agent.
SUPPORT_ENABLED=true
SUPPORT_DEMO_SEED_ENABLED=true
SUPPORT_DEMO_TENANT_ID=local
SUPPORT_DEMO_CUSTOMER_ID=customer-demo-a

# Empty disables service-level API-key authentication for local development.
SERVICE_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
